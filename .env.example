# Server-only — Google AI Studio API key for the text-chat tutor (Gemini 2.5 Flash).
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Client-exposed (safe to be public — it's an ID, not a secret) — the ElevenLabs
# Conversational AI agent ID from https://elevenlabs.io/app/conversational-ai
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Server-only — only needed if the agent is private and requires a signed URL
# (not required for a public agent embed).
ELEVENLABS_API_KEY=
